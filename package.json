{
  "name": "project-and-team-management",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint",
    "format": "prettier --write . --cache --cache-location node_modules/.cache/prettier",
    "format:check": "prettier --check . --cache --cache-location node_modules/.cache/prettier",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "fixes": "pnpm lint:fix && pnpm format",
    "clean": "rm -rf node_modules/.cache/eslint node_modules/.cache/prettier .next/cache"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-query-devtools": "^5.105.3",
    "axios": "^1.21.0",
    "better-auth": "^1.7.15",
    "better-auth-mongoose": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.66.0",
    "mongodb": "^7.8.0",
    "mongoose": "^9.11.4",
    "next": "16.4.4",
    "next-themes": "^0.4.6",
    "razorpay": "^2.9.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.4.4",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1"
  },
  "packageManager": "pnpm@10.27.0"
}
