# Database (required)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ptm?schema=public"

# Auth (required, >= 16 chars)
AUTH_SECRET="change-me-to-a-long-random-string"

# Seeded platform OWNER (required for `pnpm db:seed`; also gates create-workspace at runtime)
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD="change-me-to-a-strong-password"
OWNER_NAME="Owner"
TENANT_NAME="Workspace"
TENANT_SLUG="demo"

# Canonical app URL (single host — no tenant subdomains)
# Dev: open http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email (optional in development — sends are skipped without a key)
RESEND_API_KEY=
# Dev: Resend rewrites recipients to this address
RESEND_TEST_RECIPIENT=
# Prod: verified sender, e.g. invoices@yourdomain.com
RESEND_FROM_EMAIL=

# Stripe (optional — public checkout returns 503 when unset)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Zoho Books OAuth (optional — Sync with Zoho Books is unavailable when unset)
# Register a server-based client at https://api-console.zoho.com/
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Must match the redirect URI registered in Zoho API Console
ZOHO_REDIRECT_URI="http://localhost:3000/api/integrations/zoho/callback"
# Data center defaults (change for .eu / .in / .com.au etc.)
ZOHO_ACCOUNTS_URL="https://accounts.zoho.in"
ZOHO_API_BASE_URL="https://www.zohoapis.in"
